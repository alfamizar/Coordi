    <TargetFrameworks>net10.0-ios;net10.0-android36.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>JustCompute</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
    <!-- Display name -->
    <ApplicationTitle>Coordi</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.cutecompute.coordi</ApplicationId>
    <ApplicationIdGuid>b09e0a6c-4e76-48d3-8aa1-0d34c37b1c47</ApplicationIdGuid>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>3</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
    <PublishAot>False</PublishAot>
    <!-- Compile XAML bindings into source where possible: faster runtime binding, fewer reflection calls. -->
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
  </PropertyGroup>
  <!-- Android: keep only modern device + x64 emulator RIDs. Dropped android-x86 (no real devices). -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-ios|AnyCPU'">
    <CreatePackage>false</CreatePackage>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-ios|AnyCPU'">
    <CreatePackage>false</CreatePackage>
  </PropertyGroup>
  <!-- ============================================================
       Release-only performance settings
       ============================================================ -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <!-- iOS Release: full AOT is mandatory on iOS.
       GeoTimeZone and NodaTime are interpreted instead of AOT-compiled because their AOT modules
       fail to load on Mono with "dependency cannot be found or out of date" — the AOT/trim
       pipeline drops a transitive dependency between them and the runtime can't resolve it.
       Both libraries do one-shot lookups (lat/lon → timezone) on non-hot paths, so the
       interpreter cost is negligible. Everything else stays AOT-compiled. -->
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)'=='Release|net10.0-ios'">
    <MtouchInterpreter>GeoTimeZone,NodaTime</MtouchInterpreter>
  </PropertyGroup>
  <!-- LLVM optimizes the native code AOT produces. Applied to both device and simulator —
       once the GeoTimeZone/NodaTime AOT-module-load bug is bypassed by the interpreter
       setting above, LLVM on simulator turned out to be fine in practice. -->
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)'=='Release|net10.0-ios'">
    <MtouchUseLlvm>true</MtouchUseLlvm>
  </PropertyGroup>
  
  <!-- Android Release — known-good optimization set.

       EnableLLVM stays OFF, and it is not AutoMapper's fault. AutoMapper was removed in favour
       of hand-written mappers (JustCompute.Persistence.Mapping) partly to try this, and a
       Release AOT+LLVM build still aborts within seconds of launch:

         Assertion at aot-runtime.c:5341, condition `plt_entry' not met
         Fatal signal 6 (SIGABRT) in tid ... (.NET Timer)

       That is the AOT runtime failing to resolve a PLT entry in LLVM-compiled code — a
       toolchain problem, not a reflection one. Mono's own AOT alone still gives most of the
       startup and steady-state win. Re-test on a runtime upgrade, not before.

       AndroidStripILAfterAOT is safe to enable because mylinker.xml pins preserve="all"
       on the app assemblies (Compute.Core, JustCompute.Persistence), so only BCL/MAUI IL
       bodies get stripped — those assemblies don't need IL at runtime. -->
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)'=='Release|net10.0-android36.0'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <EnableLLVM>false</EnableLLVM>
    <AndroidStripILAfterAOT>true</AndroidStripILAfterAOT>
    <AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
    <AndroidLinkTool>r8</AndroidLinkTool>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The globe is drawn to fill Android's adaptive safe zone: 66dp of the 108dp layer, which
         every launcher mask is guaranteed to show. iOS has no mask and no parallax, so the same
         artwork there is just a smaller icon inside a wide navy border - it gets scaled back up
         to the size the icon was designed at. -->
    <AppIconForegroundScale>1.0</AppIconForegroundScale>
    <AppIconForegroundScale Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">1.28</AppIconForegroundScale>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <!-- Two adaptive layers, not one image used as both. A single file is copied into the
         background layer as well, and the launcher slides that layer against the foreground
         under parallax, so the globe ghosts behind itself. The background is now flat. -->
    <MauiIcon Include="Resources\AppIcon\appicon.png"
              ForegroundFile="Resources\AppIcon\appiconfg.png"
              ForegroundScale="$(AppIconForegroundScale)"
              Color="#050E38" />
    <!-- Splash Screen -->
    <!-- Same mark and same navy as the app icon: launch, icon and first screen now read as
         one thing. The old splash was unrelated artwork on #1f1f1f grey, which matched
         neither the icon nor any theme in the app. -->
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#050E38" BaseSize="128,128" />
    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />
    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
