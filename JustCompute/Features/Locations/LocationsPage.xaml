<?xml version="1.0" encoding="utf-8" ?>
<v1:BasePage xmlns:v1="clr-namespace:JustCompute.Shared.Controls"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JustCompute.Features.Locations.LocationsPage"
             xmlns:localization="clr-namespace:JustCompute.Shared.Helpers"
             xmlns:ViewModels="clr-namespace:JustCompute.Features.Locations"
             xmlns:models="clr-namespace:Compute.Core.Domain.Entities.Models;assembly=Compute.Core"
             x:DataType="ViewModels:LocationsViewModel"
             Shell.PresentationMode="Animated">

    <!-- No busy overlay: the list is seeded before anything slow runs, and the device fix that
         follows is background enrichment. Pull-to-refresh is the only progress this screen needs. -->
    <RefreshView Command="{Binding RefreshCommand}"
                 IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}">

        <ScrollView VerticalScrollBarVisibility="Never">

            <VerticalStackLayout Padding="{StaticResource PageEdgeInset}"
                                 Spacing="{StaticResource CardGap}">

                <!-- Onboarding, shown until the user picks somewhere themselves. Today explains
                     the placeholder; this is the screen where it gets acted on. -->
                <Border IsVisible="{Binding IsPlaceholderLocation}">

                    <StackLayout Padding="0"
                                 Spacing="{StaticResource CardGap}">

                        <Label Text="{localization:Localize SetYourLocationLabel}"
                               Style="{StaticResource TitleLabel}" />
                        <BoxView Style="{StaticResource DividerStyle}" />

                        <Button Text="{localization:Localize SearchCityLabel}"
                                Command="{Binding GoToSearchByCityCommand}"
                                HorizontalOptions="Fill" />

                        <Button Text="{localization:Localize AddCustomLocationLabel}"
                                Command="{Binding GoToAddLocationCommand}"
                                HorizontalOptions="Fill" />

                    </StackLayout>

                </Border>

                <!-- Current location -->
                <Border IsVisible="{Binding SelectedLocation, Converter={StaticResource IsNotNullConverter}}">

                    <StackLayout Padding="0"
                                 Spacing="{StaticResource CardGap}">

                        <Label Text="{localization:Localize CurrentLocationLabel}"
                               Style="{StaticResource TitleLabel}" />
                        <BoxView Style="{StaticResource DividerStyle}" />

                        <Grid ColumnDefinitions="Auto,*"
                              RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnSpacing="12"
                              RowSpacing="6">

                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{localization:Localize LocationNameLabel}" />
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding SelectedLocation.Name}"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="End" />

                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="{localization:Localize LatitudeLabel}" />
                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding SelectedLocation.LatitudeDms}"
                                   HorizontalTextAlignment="End" />

                            <Label Grid.Row="2" Grid.Column="0"
                                   Text="{localization:Localize LongitudeLabel}" />
                            <Label Grid.Row="2" Grid.Column="1"
                                   Text="{Binding SelectedLocation.LongitudeDms}"
                                   HorizontalTextAlignment="End" />

                            <Label Grid.Row="3" Grid.Column="0"
                                   Text="{localization:Localize TimeZoneLabel}" />
                            <Label Grid.Row="3" Grid.Column="1"
                                   Text="{Binding SelectedLocation.TimeZoneOffset.DisplayName}"
                                   HorizontalTextAlignment="End" />

                        </Grid>

                    </StackLayout>

                </Border>

                <!-- Tap a row to make it current; saved rows carry their own edit and delete actions. -->
                <Border IsVisible="{Binding LocationsCount, Converter={StaticResource IsIntNotEqualZeroConverter}}">

                    <StackLayout Padding="0"
                                 Spacing="{StaticResource CardGap}">

                        <Label Text="{localization:Localize LocationsLabel}"
                               Style="{StaticResource TitleLabel}" />
                        <BoxView Style="{StaticResource DividerStyle}" />

                        <CollectionView ItemsSource="{Binding Locations}"
                                        SelectionMode="Single"
                                        SelectedItem="{Binding SelectedLocation, Mode=TwoWay}">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical"
                                                   ItemSpacing="2" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Location">
                                    <!-- The row owns its selected look: left to the platform,
                                         CollectionView paints a hard-edged full-bleed fill. -->
                                    <Border Padding="12,10"
                                            Margin="0,2"
                                            StrokeThickness="1"
                                            Stroke="Transparent"
                                            BackgroundColor="Transparent"
                                            StrokeShape="RoundRectangle 10">

                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroupList>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal">
                                                        <VisualState.Setters>
                                                            <Setter Property="BackgroundColor"
                                                                    Value="Transparent" />
                                                            <Setter Property="Stroke"
                                                                    Value="Transparent" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="Selected">
                                                        <VisualState.Setters>
                                                            <Setter Property="BackgroundColor"
                                                                    Value="{DynamicResource ThemeMutedSurface}" />
                                                            <Setter Property="Stroke"
                                                                    Value="{DynamicResource ThemePrimary}" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateGroupList>
                                        </VisualStateManager.VisualStateGroups>

                                        <Grid ColumnDefinitions="*,Auto,Auto"
                                              ColumnSpacing="0">

                                            <VerticalStackLayout Grid.Column="0"
                                                                 Spacing="2"
                                                                 VerticalOptions="Center">
                                                <Label Text="{Binding Name}"
                                                       FontAttributes="Bold" />
                                                <Label Text="{Binding LatitudeDms}"
                                                       Style="{StaticResource CaptionLabel}" />
                                                <Label Text="{Binding LongitudeDms}"
                                                       Style="{StaticResource CaptionLabel}" />
                                            </VerticalStackLayout>

                                            <!-- Only a place the user saved can be edited or removed:
                                                 the device's own position and the placeholder are not
                                                 rows in the database. -->
                                            <!-- 32dp of ink inside a 48dp target: the icon reads
                                                 small, but the tap area still meets the platform
                                                 minimum. The button itself is inert; the
                                                 surrounding cell takes the tap. -->
                                            <Grid Grid.Column="1"
                                                  IsVisible="{Binding IsSaved}"
                                                  WidthRequest="48"
                                                  HeightRequest="48"
                                                  VerticalOptions="Center">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ViewModels:LocationsViewModel}}, Path=EditLocationCommand, x:DataType=ViewModels:LocationsViewModel}"
                                                                          CommandParameter="{Binding .}" />
                                                </Grid.GestureRecognizers>
                                                <!-- Still an ImageButton: it is what draws these
                                                     glyphs correctly on their filled ground. Inert
                                                     here — the 48dp cell around it takes the tap. -->
                                                <ImageButton InputTransparent="True"
                                                             Source="{AppThemeBinding Light=edit_icon_light.png, Dark=edit_icon_dark.png}"
                                                             WidthRequest="32"
                                                             HeightRequest="32"
                                                             MinimumWidthRequest="32"
                                                             MinimumHeightRequest="32"
                                                             Padding="6"
                                                             CornerRadius="8"
                                                             HorizontalOptions="Center"
                                                             VerticalOptions="Center" />
                                            </Grid>

                                            <!-- 32dp of ink inside a 48dp target: the icon reads
                                                 small, but the tap area still meets the platform
                                                 minimum. The button itself is inert; the
                                                 surrounding cell takes the tap. -->
                                            <Grid Grid.Column="2"
                                                  IsVisible="{Binding IsSaved}"
                                                  WidthRequest="48"
                                                  HeightRequest="48"
                                                  VerticalOptions="Center">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ViewModels:LocationsViewModel}}, Path=DeleteLocationCommand, x:DataType=ViewModels:LocationsViewModel}"
                                                                          CommandParameter="{Binding .}" />
                                                </Grid.GestureRecognizers>
                                                <!-- Still an ImageButton: it is what draws these
                                                     glyphs correctly on their filled ground. Inert
                                                     here — the 48dp cell around it takes the tap. -->
                                                <ImageButton InputTransparent="True"
                                                             Source="{AppThemeBinding Light=delete_icon_light.png, Dark=delete_icon_dark.png}"
                                                             WidthRequest="32"
                                                             HeightRequest="32"
                                                             MinimumWidthRequest="32"
                                                             MinimumHeightRequest="32"
                                                             Padding="6"
                                                             CornerRadius="8"
                                                             HorizontalOptions="Center"
                                                             VerticalOptions="Center" />
                                            </Grid>

                                        </Grid>

                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </StackLayout>

                </Border>

                <!-- Add a location -->
                <Border IsVisible="{Binding IsPlaceholderLocation, Converter={StaticResource InvertedBoolConverter}}">

                    <StackLayout Padding="0"
                                 Spacing="{StaticResource CardGap}">

                        <Label Text="{localization:Localize AddLocationLabel}"
                               Style="{StaticResource TitleLabel}" />
                        <BoxView Style="{StaticResource DividerStyle}" />

                        <Button Text="{localization:Localize SearchCityLabel}"
                                Command="{Binding GoToSearchByCityCommand}"
                                HorizontalOptions="Fill" />

                        <Button Text="{localization:Localize AddCustomLocationLabel}"
                                Command="{Binding GoToAddLocationCommand}"
                                HorizontalOptions="Fill" />

                    </StackLayout>

                </Border>

            </VerticalStackLayout>

    </ScrollView>

    </RefreshView>

</v1:BasePage>
