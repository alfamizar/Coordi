<?xml version="1.0" encoding="utf-8" ?>
<v1:BasePage xmlns:v1="clr-namespace:JustCompute.Shared.Controls"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:design="clr-namespace:JustCompute.Shared.Design"
             xmlns:extendedcontrols="clr-namespace:JustCompute.Shared.Controls"
             x:Class="JustCompute.Features.Settings.SettingsPage"
             xmlns:localization="clr-namespace:JustCompute.Shared.Helpers"
             xmlns:ViewModels="clr-namespace:JustCompute.Features.Settings"
             x:DataType="ViewModels:SettingsViewModel"
             xmlns:controls="clr-namespace:JustCompute.Shared.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Shell.TabBarIsVisible="False">

    <ContentPage.Resources>
        <!-- One segment's tap target: the full 48, with the pill drawn inset inside it. The track
             has no padding of its own, so the inset is part of what a tap can land on. -->
        <Style x:Key="SegmentTargetStyle" TargetType="Grid">
            <Setter Property="MinimumHeightRequest" Value="{StaticResource MinTouchTarget}" />
            <Setter Property="Padding" Value="{design:Inset Micro}" />
        </Style>

        <!-- The pill: the track's 12 less the 4 it is inset by. -->
        <Style x:Key="SegmentBorderStyle" TargetType="Border">
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="{StaticResource ControlCornerRadius}" />
                </Setter.Value>
            </Setter>
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="{design:Inset Horizontal=Small}" />
        </Style>

        <Style x:Key="SegmentLabelStyle" TargetType="Label">
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <!-- No cards on this screen, so the settings stand on the 16 text line themselves, where a
         card's text would be. A label is kept closer to its control than to the setting above it. -->
    <VerticalStackLayout Padding="{StaticResource TextPageInset}" Spacing="{StaticResource SpacingSmall}">

        <VerticalStackLayout Spacing="{StaticResource SpacingMicro}">
            <Label Text="{localization:Localize ThemeLabel}" />
            <Picker x:Name="ThemePicker"
                    Title="{Binding SelectedThemeOption.Name}"
                    ItemsSource="{Binding ThemeOptions}"
                    SelectedItem="{Binding SelectedThemeOption}" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="{StaticResource SpacingMicro}">
            <Label Text="{localization:Localize DistanceUnitLabel}" />
            <Picker x:Name="DistanceTypePicker"
                    Title="{Binding SelectedDistanceUnitOfMeasure.DistanceUomName}"
                    ItemsSource="{Binding DistanceUnitOfMeasures}"
                    SelectedItem="{Binding SelectedDistanceUnitOfMeasure}" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="{StaticResource SpacingMicro}">
            <Label Text="{localization:Localize SpeedUnitLabel}" />
            <Border Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                    Padding="0">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="0">

                    <Grid Grid.Column="0"
                          Style="{StaticResource SegmentTargetStyle}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectSpeedUnitCommand}"
                                                  CommandParameter="MetersPerSecond" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource SegmentBorderStyle}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding IsMetersPerSecondSelected}"
                                             Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource ThemePrimary}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Style="{StaticResource SegmentLabelStyle}"
                                   Text="{localization:Localize MetersPerSecondLabel}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding IsMetersPerSecondSelected}"
                                                 Value="True">
                                        <Setter Property="TextColor"
                                                Value="{DynamicResource ThemeOnPrimary}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="1"
                          Style="{StaticResource SegmentTargetStyle}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectSpeedUnitCommand}"
                                                  CommandParameter="KilometersPerHour" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource SegmentBorderStyle}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding IsKilometersPerHourSelected}"
                                             Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource ThemePrimary}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Style="{StaticResource SegmentLabelStyle}"
                                   Text="{localization:Localize KilometersPerHourLabel}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding IsKilometersPerHourSelected}"
                                                 Value="True">
                                        <Setter Property="TextColor"
                                                Value="{DynamicResource ThemeOnPrimary}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="2"
                          Style="{StaticResource SegmentTargetStyle}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectSpeedUnitCommand}"
                                                  CommandParameter="MilesPerHour" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource SegmentBorderStyle}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding IsMilesPerHourSelected}"
                                             Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource ThemePrimary}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Style="{StaticResource SegmentLabelStyle}"
                                   Text="{localization:Localize MilesPerHourLabel}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding IsMilesPerHourSelected}"
                                                 Value="True">
                                        <Setter Property="TextColor"
                                                Value="{DynamicResource ThemeOnPrimary}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </Grid>

                </Grid>
            </Border>
        </VerticalStackLayout>

        <Grid ColumnDefinitions="Auto, *">
            <Label Grid.Column="0"
                   Text="{localization:Localize Use24HourTimeFormatLabel}"
                   VerticalOptions="Center" />
            <CheckBox Grid.Column="1"
                      IsChecked="{Binding Is24HourTimeFormat}"
                      VerticalOptions="Center"
                      HorizontalOptions="End">
            </CheckBox>
        </Grid>

    </VerticalStackLayout>

</v1:BasePage>
