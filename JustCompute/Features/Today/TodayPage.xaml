<?xml version="1.0" encoding="utf-8" ?>
<v1:BasePage xmlns:v1="clr-namespace:JustCompute.Shared.Controls"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:extendedcontrols="clr-namespace:JustCompute.Shared.Controls"
             x:Class="JustCompute.Features.Today.TodayPage"
             xmlns:localization="clr-namespace:JustCompute.Shared.Helpers"
             xmlns:ViewModels="clr-namespace:JustCompute.Features.Today"
             xmlns:weatherUi="clr-namespace:JustCompute.Features.Weather"
             xmlns:converters="clr-namespace:JustCompute.Shared.Converters"
             xmlns:models="clr-namespace:Compute.Core.Domain.Entities.Models;assembly=Compute.Core"
             x:DataType="ViewModels:TodayViewModel"
             Title="{Binding LocationName}">

    <AbsoluteLayout>

        <RefreshView AbsoluteLayout.LayoutBounds="0,0,1,1"
                     AbsoluteLayout.LayoutFlags="All"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}">

            <ScrollView VerticalScrollBarVisibility="Never">

                <VerticalStackLayout Padding="{StaticResource CardPageInset}"
                                     Spacing="{StaticResource CardGap}">

                    <!-- The night at a glance, before any table: a verdict, how much cloud, and
                         when it is actually dark. Copied in concept from Penombre's Tonight
                         banner. It carries its own colour rather than the theme's, so "clear"
                         reads the same whichever palette is on.

                         While the forecast is in flight the verdict stays Unknown and wears the
                         neutral colour, rather than guessing at Clear and correcting itself. -->
                    <Border Background="{Binding Verdict, Converter={StaticResource SkyVerdictToColorConverter}}"
                            IsVisible="{Binding Snapshot, Converter={StaticResource IsNotNullConverter}}">

                        <StackLayout Padding="0"
                                     Spacing="{StaticResource SpacingMicro}">

                            <Label Text="{Binding SelectedDate, Converter={StaticResource DateOnlyToShortDateConverter}}"
                                   Style="{StaticResource CaptionLabel}"
                                   TextColor="White"
                                   Opacity="0.8" />

                            <Label Text="{Binding Verdict, Converter={StaticResource SkyVerdictToTextConverter}}"
                                   FontSize="{StaticResource FontSizeHeader}"
                                   FontAttributes="Bold"
                                   TextColor="White" />

                            <Label Text="{Binding CloudSummary}"
                                   IsVisible="{Binding HasCloudSummary}"
                                   Style="{StaticResource CollectionViewLabel}"
                                   TextColor="White"
                                   Opacity="0.9" />

                            <Label Text="{Binding DarkWindow}"
                                   IsVisible="{Binding HasDarkWindow}"
                                   Style="{StaticResource CollectionViewLabel}"
                                   TextColor="White"
                                   Opacity="0.9" />

                            <Label Text="{localization:Localize NoAstronomicalDarkLabel}"
                                   IsVisible="{Binding HasDarkWindow, Converter={StaticResource InvertedBoolConverter}}"
                                   Style="{StaticResource CollectionViewLabel}"
                                   TextColor="White"
                                   Opacity="0.9" />

                        </StackLayout>

                    </Border>

                    <!-- Date control: this is the time-travel surface. Every card below reacts to it.
                         Stepping is outlined, so the card's buttons do not outshout the date. -->
                    <Border>

                        <StackLayout Padding="0"
                                     Spacing="{StaticResource RowGap}">

                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                                  ColumnSpacing="{StaticResource SpacingMicro}"
                                  VerticalOptions="Center">

                                <Button Grid.Column="0"
                                        Style="{StaticResource OutlinedButton}"
                                        Text="&#x00AB;"
                                        Command="{Binding PreviousMonthCommand}"
                                        WidthRequest="{StaticResource MinTouchTarget}"
                                        Padding="0" />

                                <Button Grid.Column="1"
                                        Style="{StaticResource OutlinedButton}"
                                        Text="&#x2039;"
                                        Command="{Binding PreviousDayCommand}"
                                        WidthRequest="{StaticResource MinTouchTarget}"
                                        Padding="0" />

                                <!-- Centred rather than stretched: filling the column left the
                                     date hard against the previous-day button with a long rule
                                     trailing off to the right. -->
                                <DatePicker Grid.Column="2"
                                            MinimumDate="01/01/1900"
                                            MaximumDate="12/31/2100"
                                            Date="{Binding SelectedDate, Mode=TwoWay}"
                                            HorizontalOptions="Center" />

                                <Button Grid.Column="3"
                                        Style="{StaticResource OutlinedButton}"
                                        Text="&#x203A;"
                                        Command="{Binding NextDayCommand}"
                                        WidthRequest="{StaticResource MinTouchTarget}"
                                        Padding="0" />

                                <Button Grid.Column="4"
                                        Style="{StaticResource OutlinedButton}"
                                        Text="&#x00BB;"
                                        Command="{Binding NextMonthCommand}"
                                        WidthRequest="{StaticResource MinTouchTarget}"
                                        Padding="0" />

                            </Grid>

                            <Button Text="{localization:Localize TodayLabel}"
                                    Style="{StaticResource OutlinedButton}"
                                    Command="{Binding GoToTodayCommand}"
                                    IsVisible="{Binding IsShowingToday, Converter={StaticResource InvertedBoolConverter}}"
                                    HorizontalOptions="Center" />

                        </StackLayout>

                    </Border>

                    <!-- Onboarding: the app is showing a placeholder, and says so plainly rather
                         than greeting a first-time user with an error. -->
                    <Border IsVisible="{Binding IsPlaceholderLocation}">

                        <StackLayout Padding="0"
                                     Spacing="{StaticResource RowGap}">

                            <Label Text="{localization:Localize SetYourLocationLabel}"
                                   Style="{StaticResource TitleLabel}" />

                            <Label Text="{Binding LocationName, StringFormat={localization:Localize PlaceholderLocationNoticeLabel}}" />

                            <Button Text="{localization:Localize LocationsLabel}"
                                    Command="{Binding SetLocationCommand}"
                                    HorizontalOptions="Fill" />

                        </StackLayout>

                    </Border>

                    <VerticalStackLayout Spacing="{StaticResource CardGap}"
                                         IsVisible="{Binding Snapshot, Converter={StaticResource IsNotNullConverter}}">

                        <!-- Weather only exists for the current date; hidden when time-travelling. -->
                        <Border IsVisible="{Binding IsDateWithinForecast}">

                            <StackLayout Padding="0"
                                         Spacing="{StaticResource RowGap}">

                                <Label Text="{localization:Localize WeatherLabel}"
                                       Style="{StaticResource TitleLabel}" />
                                <BoxView Style="{StaticResource DividerStyle}" />

                                <extendedcontrols:ShimmerSkeletonView CellCount="7"
                                                                      IsVisible="{Binding IsWeatherLoading}" />

                                <Label Text="{localization:Localize WeatherUnavailableLabel}"
                                       IsVisible="{Binding IsWeatherFailed}"
                                       HorizontalOptions="Center"
                                       Style="{StaticResource HintLabel}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding RetryWeatherCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>

                                <Border Padding="0"
                                        IsVisible="{Binding WeatherForecast, Converter={StaticResource IsNotNullConverter}}"
                                        Background="{DynamicResource ThemeSecondary}">
                                    <Grid ColumnDefinitions="*,1,*,1,*,1,*,1,*,1,*,1,*"
                                          ColumnSpacing="0">

                                        <weatherUi:WeatherDayCell Grid.Column="0"
                                                                  Day="{Binding WeatherForecast.Days[0]}" />
                                        <BoxView Grid.Column="1"
                                                 BackgroundColor="#44000000"
                                                 VerticalOptions="Fill"
                                                 WidthRequest="1" />
                                        <weatherUi:WeatherDayCell Grid.Column="2"
                                                                  Day="{Binding WeatherForecast.Days[1]}" />
                                        <BoxView Grid.Column="3"
                                                 BackgroundColor="#44000000"
                                                 VerticalOptions="Fill"
                                                 WidthRequest="1" />
                                        <weatherUi:WeatherDayCell Grid.Column="4"
                                                                  Day="{Binding WeatherForecast.Days[2]}" />
                                        <BoxView Grid.Column="5"
                                                 BackgroundColor="#44000000"
                                                 VerticalOptions="Fill"
                                                 WidthRequest="1" />
                                        <weatherUi:WeatherDayCell Grid.Column="6"
                                                                  Day="{Binding WeatherForecast.Days[3]}" />
                                        <BoxView Grid.Column="7"
                                                 BackgroundColor="#44000000"
                                                 VerticalOptions="Fill"
                                                 WidthRequest="1" />
                                        <weatherUi:WeatherDayCell Grid.Column="8"
                                                                  Day="{Binding WeatherForecast.Days[4]}" />
                                        <BoxView Grid.Column="9"
                                                 BackgroundColor="#44000000"
                                                 VerticalOptions="Fill"
                                                 WidthRequest="1" />
                                        <weatherUi:WeatherDayCell Grid.Column="10"
                                                                  Day="{Binding WeatherForecast.Days[5]}" />
                                        <BoxView Grid.Column="11"
                                                 BackgroundColor="#44000000"
                                                 VerticalOptions="Fill"
                                                 WidthRequest="1" />
                                        <weatherUi:WeatherDayCell Grid.Column="12"
                                                                  Day="{Binding WeatherForecast.Days[6]}" />

                                    </Grid>
                                </Border>

                            </StackLayout>

                        </Border>

                        <Border>

                            <StackLayout Padding="0"
                                         Spacing="{StaticResource RowGap}">

                                <Label Text="{localization:Localize SunLabel}"
                                       Style="{StaticResource TitleLabel}" />
                                <BoxView Style="{StaticResource DividerStyle}" />

                                <Border Padding="0">
                                    <extendedcontrols:SunPathView RiseTime="{Binding Snapshot.SunRise}"
                                                                  SetTime="{Binding Snapshot.SunSet}"
                                                                  CurrentTime="{Binding CurrentTime}" />
                                </Border>

                                <!-- Rise and set in the order they happen, then the day they make. -->
                                <VerticalStackLayout Spacing="{StaticResource RowGap}">
                                    <extendedcontrols:KeyValueRow Title="{localization:Localize SunRiseLabel}"
                                                                  Value="{Binding Snapshot.SunRise, Converter={StaticResource TimeFormatConverter}}" />
                                    <extendedcontrols:KeyValueRow Title="{localization:Localize SunSetLabel}"
                                                                  Value="{Binding Snapshot.SunSet, Converter={StaticResource TimeFormatConverter}}" />
                                    <extendedcontrols:KeyValueRow Title="{localization:Localize DayDurationLabel}">
                                        <extendedcontrols:KeyValueRow.Value>
                                            <MultiBinding StringFormat="{}{0}">
                                                <MultiBinding.Converter>
                                                    <converters:RiseAndSetToDurationConverter CelestialBody="Sun" />
                                                </MultiBinding.Converter>
                                                <Binding Path="Snapshot.SunRise" />
                                                <Binding Path="Snapshot.SunSet" />
                                            </MultiBinding>
                                        </extendedcontrols:KeyValueRow.Value>
                                    </extendedcontrols:KeyValueRow>
                                </VerticalStackLayout>

                                <!-- Twilight, in the order it happens: first light up to sunrise,
                                     then sunset down to last light. The list carries only the
                                     stages that occur, so a northern summer night — where the Sun
                                     never reaches -18°, or even -12° — simply shows fewer rows,
                                     and under the midnight sun the whole section disappears. -->
                                <BoxView Style="{StaticResource DividerStyle}"
                                         IsVisible="{Binding Snapshot.TwilightStages, Converter={StaticResource IsListNotNullOrEmptyConverter}}" />

                                <Label Text="{localization:Localize TwilightSectionLabel}"
                                       Style="{StaticResource SectionHeaderLabel}"
                                       IsVisible="{Binding Snapshot.TwilightStages, Converter={StaticResource IsListNotNullOrEmptyConverter}}" />

                                <VerticalStackLayout Spacing="{StaticResource RowGap}"
                                                     BindableLayout.ItemsSource="{Binding Snapshot.TwilightStages}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:TwilightStage">
                                            <Grid ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="{StaticResource SpacingSmall}">
                                                <Label Grid.Column="0"
                                                       Text="{Binding Label, Converter={StaticResource TwilightLabelToNameConverter}}" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding Time, Converter={StaticResource TimeFormatConverter}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <BoxView Style="{StaticResource DividerStyle}"
                                         IsVisible="{Binding Snapshot.TwilightStages, Converter={StaticResource IsListNotNullOrEmptyConverter}}" />

                                <extendedcontrols:KeyValueRow Title="{localization:Localize ZodiacSignLabel}"
                                                              Value="{Binding Snapshot.ZodiacSign, Converter={StaticResource ZodiacSignEnumToLocalizedStringConverter}}" />
                            </StackLayout>

                        </Border>

                        <Border>

                            <StackLayout Padding="0"
                                         Spacing="{StaticResource RowGap}">

                                <Label Text="{localization:Localize MoonLabel}"
                                       Style="{StaticResource TitleLabel}" />
                                <BoxView Style="{StaticResource DividerStyle}" />

                                <!-- In the Sun card's order: rise, set and the time between, then the
                                     Moon's own state. -->
                                <VerticalStackLayout Spacing="{StaticResource RowGap}">
                                    <extendedcontrols:KeyValueRow Title="{localization:Localize MoonRiseLabel}"
                                                                  Value="{Binding Snapshot.MoonRise, Converter={StaticResource TimeFormatConverter}}" />
                                    <extendedcontrols:KeyValueRow Title="{localization:Localize MoonSetLabel}"
                                                                  Value="{Binding Snapshot.MoonSet, Converter={StaticResource TimeFormatConverter}}" />
                                    <extendedcontrols:KeyValueRow Title="{localization:Localize MoonRiseDurationLabel}">
                                        <extendedcontrols:KeyValueRow.Value>
                                            <MultiBinding StringFormat="{}{0}">
                                                <MultiBinding.Converter>
                                                    <converters:RiseAndSetToDurationConverter CelestialBody="Moon" />
                                                </MultiBinding.Converter>
                                                <Binding Path="Snapshot.MoonRise" />
                                                <Binding Path="Snapshot.MoonSet" />
                                            </MultiBinding>
                                        </extendedcontrols:KeyValueRow.Value>
                                    </extendedcontrols:KeyValueRow>
                                    <extendedcontrols:KeyValueRow Title="{localization:Localize MoonPhaseLabel}"
                                                                  Value="{Binding Snapshot, Converter={StaticResource CoordinateToMoonPhaseConverter}}" />
                                    <extendedcontrols:KeyValueRow Title="{localization:Localize DistanceLabel}"
                                                                  Value="{Binding Snapshot.MoonDistanceKm, Converter={StaticResource KilometersToTargetDistanceTypeConverter}}" />
                                    <extendedcontrols:KeyValueRow Title="{localization:Localize MoonInZodiacSignLabel}"
                                                                  Value="{Binding Snapshot.MoonSign, Converter={StaticResource ZodiacSignEnumToLocalizedStringConverter}}" />
                                </VerticalStackLayout>
                            </StackLayout>

                        </Border>

                        <Border IsVisible="{Binding Snapshot.Mgrs, Converter={StaticResource IsNotNullConverter}}">

                            <StackLayout Padding="0"
                                         Spacing="{StaticResource RowGap}">

                                <Label Text="{localization:Localize MGRSLabel}"
                                       Style="{StaticResource TitleLabel}" />
                                <BoxView Style="{StaticResource DividerStyle}" />

                                <VerticalStackLayout Spacing="{StaticResource RowGap}">
                                    <extendedcontrols:KeyValueRow Title="{localization:Localize DigraphLabel}"
                                                                  Value="{Binding Snapshot.Mgrs.Digraph, StringFormat='{0}'}" />
                                    <extendedcontrols:KeyValueRow Title="{localization:Localize MGRSEastingLabel}"
                                                                  Value="{Binding Snapshot.Mgrs.Easting, StringFormat='{0}'}" />
                                    <extendedcontrols:KeyValueRow Title="{localization:Localize MGRSNorthingLabel}"
                                                                  Value="{Binding Snapshot.Mgrs.Northing, StringFormat='{0}'}" />
                                    <extendedcontrols:KeyValueRow Title="{localization:Localize MGRSLatZoneLabel}"
                                                                  Value="{Binding Snapshot.Mgrs.LatZone, StringFormat='{0}'}" />
                                    <extendedcontrols:KeyValueRow Title="{localization:Localize MGRSLonZoneLabel}"
                                                                  Value="{Binding Snapshot.Mgrs.LongZone, StringFormat='{0}'}" />
                                    <extendedcontrols:KeyValueRow Title="{localization:Localize MGRSTypeLabel}"
                                                                  Value="{Binding Snapshot.Mgrs.SystemType, StringFormat='{0}'}" />
                                </VerticalStackLayout>

                            </StackLayout>
                        </Border>

                        <Border IsVisible="{Binding Snapshot.Utm, Converter={StaticResource IsNotNullConverter}}">

                            <StackLayout Padding="0"
                                         Spacing="{StaticResource RowGap}">

                                <Label Text="{localization:Localize UTMLabel}"
                                       Style="{StaticResource TitleLabel}" />
                                <BoxView Style="{StaticResource DividerStyle}" />

                                <VerticalStackLayout Spacing="{StaticResource RowGap}">
                                    <extendedcontrols:KeyValueRow Title="{localization:Localize InverseFlatteningLabel}"
                                                                  Value="{Binding Snapshot.Utm.InverseFlattening, StringFormat='{0}'}" />
                                    <extendedcontrols:KeyValueRow Title="{localization:Localize UTMEastingLabel}"
                                                                  Value="{Binding Snapshot.Utm.Easting, StringFormat='{0:0.##}'}" />
                                    <extendedcontrols:KeyValueRow Title="{localization:Localize UTMNorthingLabel}"
                                                                  Value="{Binding Snapshot.Utm.Northing, StringFormat='{0:0.##}'}" />
                                    <extendedcontrols:KeyValueRow Title="{localization:Localize UTMLatZoneLabel}"
                                                                  Value="{Binding Snapshot.Utm.LatZone, StringFormat='{0}'}" />
                                    <extendedcontrols:KeyValueRow Title="{localization:Localize UTMLonZoneLabel}"
                                                                  Value="{Binding Snapshot.Utm.LongZone, StringFormat='{0}'}" />
                                    <extendedcontrols:KeyValueRow Title="{localization:Localize UTMTypeLabel}"
                                                                  Value="{Binding Snapshot.Utm.SystemType, StringFormat='{0}'}" />
                                </VerticalStackLayout>

                            </StackLayout>

                        </Border>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </ScrollView>

        </RefreshView>

        <!-- Centred at its own size; the style gives it the one size every screen uses. -->
        <ActivityIndicator AbsoluteLayout.LayoutFlags="PositionProportional"
                           AbsoluteLayout.LayoutBounds="0.5,0.5,AutoSize,AutoSize"
                           IsRunning="{Binding IsBusy}">
            <ActivityIndicator.IsVisible>
                <MultiBinding Converter="{StaticResource AllTrueConverter}">
                    <Binding Path="IsBusy" />
                    <Binding Path="IsRefreshing"
                             Converter="{StaticResource InvertedBoolConverter}" />
                </MultiBinding>
            </ActivityIndicator.IsVisible>
        </ActivityIndicator>

    </AbsoluteLayout>

</v1:BasePage>
