<?xml version="1.0" encoding="utf-8" ?>
<v1:BasePage xmlns:v1="clr-namespace:JustCompute.Shared.Controls"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JustCompute.Features.SpeedAndDistance.SpeedAndDistancePage"
             xmlns:localization="clr-namespace:JustCompute.Shared.Helpers"
             xmlns:ViewModels="clr-namespace:JustCompute.Features.SpeedAndDistance"
             Shell.TabBarIsVisible="False"
             xmlns:views="clr-namespace:JustCompute.Shared.Controls"
             x:DataType="ViewModels:SpeedAndDistanceViewModel">

    <!-- Margin 4 is the content inset Today, Optics and the Ruler all use on their
         scrolling container; with the implicit Border margin of 8 it puts every card and
         tile at the same 12 from the screen edge as the rest of the app. -->
    <Grid RowDefinitions="*, Auto, Auto"
          Margin="4">

        <ScrollView Grid.Row="0"
                    VerticalScrollBarVisibility="Never">

            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="12">

                <views:DynamicInfoItem
                    Grid.Row="0" Grid.Column="0"
                    ItemTitle="{localization:Localize SpeedLabel}"
                    ItemValue="{Binding FormattedSpeed}" />

                <views:DynamicInfoItem
                    Grid.Row="0" Grid.Column="1"
                    ItemTitle="{localization:Localize CalculatedSpeedLabel}"
                    ItemValue="{Binding FormattedCalculatedSpeed}" />

                <views:DynamicInfoItem
                    Grid.Row="1" Grid.Column="0"
                    ItemTitle="{localization:Localize DirectionLabel}"
                    ItemValue="{Binding Direction, StringFormat={localization:Localize FormattedDegreesLabel}}" />

                <views:DynamicInfoItem
                    Grid.Row="1" Grid.Column="1"
                    ItemTitle="{localization:Localize AccuracyLabel}"
                    ItemValue="{Binding FormattedAccuracy}" />

                <views:DynamicInfoItem
                    Grid.Row="2" Grid.Column="0"
                    ItemTitle="{localization:Localize VertialAccuracyLabel}"
                    ItemValue="{Binding FormattedVerticalAccuracy}" />

                <views:DynamicInfoItem
                    Grid.Row="2" Grid.Column="1"
                    ItemTitle="{localization:Localize AltitudeLabel}"
                    ItemValue="{Binding FormattedAltitude}" />

                <views:DynamicInfoItem
                    Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                    ItemTitle="{localization:Localize ElevationLabel}"
                    ItemValue="{Binding FormattedElevation}" />

            </Grid>

        </ScrollView>

        <!-- Padding 8 and the inherited 8,4 margin, which is what every other card in the app
             uses; the page adds no padding of its own, so this lines up both with the tiles
             above it and with the cards on Today, Optics and the Ruler. -->
        <Border Grid.Row="1"
                Padding="8"
                IsVisible="{Binding HasTrip}">

            <StackLayout Spacing="8">

                <Label Text="{localization:Localize DistanceLabel}"
                       Style="{StaticResource TitleLabel}" />
                <BoxView Style="{StaticResource DividerStyle}" />

                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{localization:Localize TravelledDistanceLabel}" />
                    <Label Grid.Column="1" Text="{Binding FormattedTravelledDistance}" FontAttributes="Bold" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{localization:Localize DirectDistanceLabel}" />
                    <Label Grid.Column="1" Text="{Binding DirectSummary}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto"
                      IsVisible="{Binding HasDetour}">
                    <Label Grid.Column="0" Text="{localization:Localize DetourRatioLabel}" />
                    <Label Grid.Column="1" Text="{Binding DetourRatio}" />
                </Grid>

            </StackLayout>

        </Border>

        <Grid ColumnDefinitions="Auto,Auto,*"
              ColumnSpacing="8"
              Grid.Row="2">

            <ImageButton Grid.Column="0"
                         Command="{Binding ToggleLocationTrackingCommand}"
                         WidthRequest="50"
                         HeightRequest="50"
                         CornerRadius="32"
                         Background="Transparent"
                         VerticalOptions="Center"
                         Margin="8"
                         Source="{AppThemeBinding Light=play_circle_light_dark.png, Dark=play_circle_icon_light.png}">
                <ImageButton.Triggers>
                    <DataTrigger TargetType="ImageButton"
                                 Binding="{Binding IsRunning}"
                                 Value="True">
                        <Setter Property="Source"
                                Value="{AppThemeBinding Light=stop_circle_light_dark.png, Dark=stop_circle_icon_light.png}" />
                    </DataTrigger>
                </ImageButton.Triggers>
            </ImageButton>

            <Label Grid.Column="1"
                   VerticalOptions="Center"
                   Margin="8"
                   FontSize="28"
                   Text="{Binding TrackingActionLabel}" />


            <HorizontalStackLayout Grid.Column="2"
                                   HorizontalOptions="End">

                <Image Source="{AppThemeBinding Light=timer_icon_dark.png, Dark=timer_icon_light.png}"
                       VerticalOptions="Center"
                       WidthRequest="50"
                       HeightRequest="50"/>

                <Label VerticalOptions="Center"
                       Margin="8"
                       FontSize="26"
                       Text="{Binding FormattedElapsedTime}" />

            </HorizontalStackLayout>


        </Grid>

        <ActivityIndicator HeightRequest="50"
                           WidthRequest="50"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           IsVisible="{Binding IsBusy}"
                           IsRunning="{Binding IsBusy}" />

    </Grid>

</v1:BasePage>
