<?xml version="1.0" encoding="utf-8" ?>
<v1:BasePage xmlns:v1="clr-namespace:JustCompute.Shared.Controls"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:design="clr-namespace:JustCompute.Shared.Design"
             x:Class="JustCompute.Features.SearchByCity.SearchByCityPage"
             xmlns:localization="clr-namespace:JustCompute.Shared.Helpers"
             xmlns:ViewModels="clr-namespace:JustCompute.Features.SearchByCity"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:models="clr-namespace:Compute.Core.Domain.Entities.Models;assembly=Compute.Core"
             xmlns:views="clr-namespace:JustCompute.Shared.Controls"
             Shell.PresentationMode="Animated"
             Shell.TabBarIsVisible="False"
             x:DataType="ViewModels:SearchByCityViewModel"
             Title="{localization:Localize SearchCityLabel}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding GoBackCommand}"/>
    </Shell.BackButtonBehavior>

    <Grid>
        <Grid RowDefinitions="Auto, *"
              RowSpacing="{StaticResource SpacingMicro}"
              Padding="{StaticResource CardPageInset}">
            <Grid ColumnDefinitions="*,Auto"
                  Grid.Row="0"
                  ColumnSpacing="{StaticResource SpacingSmall}"
                  Padding="{design:Inset Vertical=Micro}">
                <SearchBar x:Name="searchBar"
                           Grid.Column="0"
                           Text="{Binding SearchTerm}"
                           Placeholder="{localization:Localize SearchPlaceholderLabel}"
                           IsReadOnly="{Binding IsBusy}"
                           HorizontalOptions="Fill"
                           VerticalOptions="Center">
                    <SearchBar.Behaviors>
                        <toolkit:UserStoppedTypingBehavior BindingContext="{Binding Path=BindingContext, Source={x:Reference searchBar}, x:DataType=SearchBar}"
                                                           Command="{Binding PerformSearchLocationCommand}"
                                                           CommandParameter="{Binding Text, Source={x:Reference searchBar}, x:DataType=SearchBar}"
                                                           StoppedTypingTimeThreshold="1000"
                                                           ShouldDismissKeyboardAutomatically="True"/>
                    </SearchBar.Behaviors>
                </SearchBar>
                
                <ImageButton x:Name="sortButton"
                             Grid.Column="1"
                             Style="{StaticResource IconButton}"
                             HorizontalOptions="End"
                             VerticalOptions="Center"
                             Source="{AppThemeBinding Light=sort_icon_dark.png, Dark=sort_icon_light.png}"
                             Command="{Binding ShowSortingPopupCommand}"
                             CommandParameter="{x:Reference sortButton}"
                             IsEnabled="{Binding IsBusy, Converter={toolkit:InvertedBoolConverter}}"/>
            </Grid>

            <CollectionView x:Name="locationsCollectionView"
                            Grid.Row="1"
                            ItemsSource="{Binding LocationsSearchResult}"
                            IsVisible="{Binding LocationsSearchResult, Converter={StaticResource IsListNotNullOrEmptyConverter}}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     VerticalItemSpacing="{StaticResource CardGap}"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>

                    <DataTemplate x:DataType="models:Location">

                        <views:LocationItem Location="{Binding .}"
                                            IsLocationNameVisible="False"
                                            IsButtonsVisible="False"
                                            ItemClickedCommand="{Binding Source={RelativeSource AncestorType={x:Type ViewModels:SearchByCityViewModel}}, Path=LocationSelectedCommand, x:DataType=ViewModels:SearchByCityViewModel}">
                        </views:LocationItem>

                    </DataTemplate>

                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- "Nothing matched", "the query failed" and "still loading" all used to render as
                 the same blank page. Each now says which it is, and the failure offers a retry. -->
            <Label Grid.Row="1"
                   Text="{localization:Localize CitySearchFailedLabel}"
                   IsVisible="{Binding HasSearchFailed}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Style="{StaticResource HintLabel}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding RetrySearchCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <Label Grid.Row="1"
                   Text="{localization:Localize NoCitiesFoundLabel}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Style="{StaticResource HintLabel}">
                <Label.IsVisible>
                    <MultiBinding Converter="{StaticResource AllTrueConverter}">
                        <Binding Path="LocationsSearchResult"
                                 Converter="{StaticResource IsListNullOrEmptyConverter}" />
                        <Binding Path="IsBusy"
                                 Converter="{StaticResource InvertedBoolConverter}" />
                        <Binding Path="HasSearchFailed"
                                 Converter="{StaticResource InvertedBoolConverter}" />
                    </MultiBinding>
                </Label.IsVisible>
            </Label>
        </Grid>

        <ActivityIndicator HorizontalOptions="Center"
                           VerticalOptions="Center"
                           IsVisible="{Binding IsBusy}"
                           IsRunning="{Binding IsBusy}"/>
    </Grid>

</v1:BasePage>
