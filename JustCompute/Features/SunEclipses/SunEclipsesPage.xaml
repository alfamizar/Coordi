<?xml version="1.0" encoding="utf-8" ?>
<v1:BasePage xmlns:v1="clr-namespace:JustCompute.Shared.Controls"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:design="clr-namespace:JustCompute.Shared.Design"
             x:Class="JustCompute.Features.SunEclipses.SunEclipsesPage"
             xmlns:localization="clr-namespace:JustCompute.Shared.Helpers"
             xmlns:ViewModels="clr-namespace:JustCompute.Features.SunEclipses"
             xmlns:helpers="clr-namespace:JustCompute.Presentation.Collections;assembly=JustCompute.Presentation"
             xmlns:models="clr-namespace:Compute.Core.Domain.Entities.Models.Eclipses;assembly=Compute.Core"
             xmlns:windows="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.WindowsSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:android="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.AndroidSpecific;assembly=Microsoft.Maui.Controls"
             x:DataType="ViewModels:SunEclipsesViewModel">

    <ContentPage.Resources>

        <DataTemplate x:Key="VisibleSolarEclipseTemplate" x:DataType="models:SolarEclipseInfo">

            <Border>

                <VerticalStackLayout Spacing="{StaticResource RowGap}">

                    <!-- The date, and what kind of eclipse it is from here. -->
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="{StaticResource SpacingMedium}">
                        <Label Text="{Binding Date, StringFormat='{0:dd MMMM yyyy}'}"
                               Style="{StaticResource TitleLabel}" />
                        <Label Grid.Column="1"
                               Text="{Binding ., Converter={StaticResource SunEclipseTypeToNameConverter}}"
                               VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource DividerStyle}" />

                    <!-- The contacts in the order they happen. The central ones are only there
                         where the centre of the shadow passes, and a row with nothing in it goes. -->
                    <v1:KeyValueRow Title="{localization:Localize SolarEclipseMagnitudeLabel}"
                                    Value="{Binding Magnitude, Converter={StaticResource MagnitudeConverter}}"
                                    IsVisible="{Binding Magnitude, Converter={StaticResource IsPositiveDoubleConverter}}" />
                    <v1:KeyValueRow Title="{localization:Localize PartialSolarEclipseBeginTimeLabel}"
                                    Value="{Binding PartialEclipseBegin, Converter={StaticResource TimeFormatConverter}}"
                                    IsVisible="{Binding PartialEclipseBegin, Converter={StaticResource IsDateTimeSetConverter}}" />
                    <v1:KeyValueRow Title="{localization:Localize AorTEclipseBeginTimeLabel}"
                                    Value="{Binding CentralEclipseBegin, Converter={StaticResource TimeFormatConverter}}"
                                    IsVisible="{Binding CentralEclipseBegin, Converter={StaticResource IsDateTimeSetConverter}}" />
                    <v1:KeyValueRow Title="{localization:Localize MaximumSolarEclispseTimeLabel}"
                                    Value="{Binding MaximumEclipse, Converter={StaticResource TimeFormatConverter}}"
                                    IsVisible="{Binding MaximumEclipse, Converter={StaticResource IsDateTimeSetConverter}}" />
                    <v1:KeyValueRow Title="{localization:Localize AorTEclipseEndTimeLabel}"
                                    Value="{Binding CentralEclipseEnd, Converter={StaticResource TimeFormatConverter}}"
                                    IsVisible="{Binding CentralEclipseEnd, Converter={StaticResource IsDateTimeSetConverter}}" />
                    <v1:KeyValueRow Title="{localization:Localize PartialSolarEclipseEndTimeLabel}"
                                    Value="{Binding PartialEclipseEnd, Converter={StaticResource TimeFormatConverter}}"
                                    IsVisible="{Binding PartialEclipseEnd, Converter={StaticResource IsDateTimeSetConverter}}" />
                    <v1:KeyValueRow Title="{localization:Localize AorTSolarEclipseDurationLabel}"
                                    Value="{Binding CentralDuration, Converter={StaticResource TimeFormatConverter}}"
                                    IsVisible="{Binding CentralDuration, Converter={StaticResource IsTimeSpanSetConverter}}" />

                </VerticalStackLayout>

            </Border>

        </DataTemplate>

        <DataTemplate x:Key="NotVisibleSolarEclipseTemplate" x:DataType="models:SolarEclipseInfo">

            <!-- Outlined and dimmed: there, but not from here. -->
            <Border Opacity="0.75"
                    StrokeThickness="1"
                    Stroke="{DynamicResource ThemeOutline}">

                <!-- The date, and what kind of eclipse it is from here. -->
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="{StaticResource SpacingMedium}">
                    <Label Text="{Binding Date, StringFormat='{0:dd MMMM yyyy}'}"
                           Style="{StaticResource TitleLabel}" />
                    <Label Grid.Column="1"
                           Text="{Binding ., Converter={StaticResource SunEclipseTypeToNameConverter}}"
                           VerticalOptions="Center" />
                </Grid>

            </Border>

        </DataTemplate>

        <ViewModels:SolarEclipseTemplateSelector x:Key="SolarEclipseTemplateSelector"
                                                 VisibleTemplate="{StaticResource VisibleSolarEclipseTemplate}"
                                                 NotVisibleTemplate="{StaticResource NotVisibleSolarEclipseTemplate}" />

    </ContentPage.Resources>

    <Grid Padding="{StaticResource CardPageInset}"
          RowDefinitions="Auto,*">

        <!-- The filter belongs with the list it filters, not in Settings: it is a property of
             what you are looking at, and the count says how much it is hiding. -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="{StaticResource SpacingSmall}"
              Margin="{StaticResource TextBesideCardsInset}"
              Padding="{design:Inset Vertical=Micro}">

            <CheckBox Grid.Column="0"
                      IsChecked="{Binding ShowOnlyVisible}"
                      VerticalOptions="Center" />

            <Label Grid.Column="1"
                   Text="{localization:Localize OnlyVisibleEclipsesLabel}"
                   VerticalOptions="Center" />

            <Label Grid.Column="2"
                   Text="{Binding FilterSummary}"
                   Style="{StaticResource CaptionLabel}"
                   VerticalOptions="Center" />

        </Grid>


        <!-- Two different empties: nothing computed because there is no location, and nothing
             matching because the filter hid it all. Saying the first when it is the second tells
             the reader their GPS failed when the honest answer is "none from here". -->
        <Label Grid.Row="1"
               Text="{localization:Localize CannotGetCurrentLocationLabel}"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               Style="{StaticResource HintLabel}">
            <Label.IsVisible>
                <MultiBinding Converter="{StaticResource AllTrueConverter}">
                    <Binding Path="HasNoLocation" />
                    <Binding Path="IsBusy"
                             Converter="{StaticResource InvertedBoolConverter}" />
                </MultiBinding>
            </Label.IsVisible>
        </Label>

        <Label Grid.Row="1"
               Text="{localization:Localize NoVisibleEclipsesLabel}"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               Style="{StaticResource HintLabel}">
            <Label.IsVisible>
                <MultiBinding Converter="{StaticResource AllTrueConverter}">
                    <Binding Path="HasNoVisibleMatches" />
                    <Binding Path="IsBusy"
                             Converter="{StaticResource InvertedBoolConverter}" />
                </MultiBinding>
            </Label.IsVisible>
        </Label>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding GroupedEclipseList}"
                        SelectionMode="None"
                        ItemTemplate="{StaticResource SolarEclipseTemplateSelector}"
                        IsGrouped="True">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="helpers:IGroupHeader">
                    <StackLayout Margin="{StaticResource TextBesideCardsInset}"
                                 Padding="{design:Inset Vertical=Micro}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding Title}"
                                   Style="{StaticResource SectionHeaderLabel}" />
                            <!-- Open or closed. Without it the folded past is a heading with
                                 nothing under it, and nothing says a tap opens it. -->
                            <Label Grid.Column="1"
                                   Text="{Binding IsExpanded, Converter={StaticResource ExpandMarkerConverter}}"
                                   Style="{StaticResource SectionHeaderLabel}"
                                   FontSize="{StaticResource FontSizeBody}" />
                        </Grid>
                        <BoxView Style="{StaticResource DividerStyle}" />
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ViewModels:SunEclipsesViewModel}}, Path=ToggleGroupCommand, x:DataType=ViewModels:SunEclipsesViewModel}"
                                                  CommandParameter="{Binding .}" />
                        </StackLayout.GestureRecognizers>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                                   ItemSpacing="{StaticResource CardGap}" />
            </CollectionView.ItemsLayout>

        </CollectionView>

        <!-- Row 1, over the list area: the century table takes a noticeable moment to
             compute, and without this the screen is simply blank while it does. -->
        <ActivityIndicator Grid.Row="1"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           IsVisible="{Binding IsBusy}"
                           IsRunning="{Binding IsBusy}" />

    </Grid>

</v1:BasePage>
