<?xml version="1.0" encoding="utf-8" ?>
<v1:BasePage xmlns:v1="clr-namespace:JustCompute.Shared.Controls"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JustCompute.Features.SunEclipses.SunEclipsesPage"
             xmlns:localization="clr-namespace:JustCompute.Shared.Helpers"
             xmlns:ViewModels="clr-namespace:JustCompute.Features.SunEclipses"
             xmlns:helpers="clr-namespace:Compute.Core.Helpers;assembly=Compute.Core"
             xmlns:models="clr-namespace:Compute.Core.Domain.Entities.Models.Eclipses;assembly=Compute.Core"
             xmlns:windows="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.WindowsSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:android="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.AndroidSpecific;assembly=Microsoft.Maui.Controls"
             x:DataType="ViewModels:SunEclipsesViewModel">

    <Grid Padding="4,0"
          RowDefinitions="Auto,*">

        <!-- The filter belongs with the list it filters, not in Settings: it is a property of
             what you are looking at, and the count says how much it is hiding. -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="8"
              Padding="8,4">

            <CheckBox Grid.Column="0"
                      IsChecked="{Binding ShowOnlyVisible}"
                      VerticalOptions="Center" />

            <Label Grid.Column="1"
                   Text="{localization:Localize OnlyVisibleEclipsesLabel}"
                   VerticalOptions="Center" />

            <Label Grid.Column="2"
                   Text="{Binding FilterSummary}"
                   FontSize="Small"
                   Opacity="0.7"
                   VerticalOptions="Center" />

        </Grid>


        <Label Grid.Row="1"
               Text="{localization:Localize CannotGetCurrentLocationLabel}"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               Padding="8">
            <Label.IsVisible>
                <MultiBinding Converter="{StaticResource AllTrueConverter}">
                    <Binding Path="GroupedEclipseList"
                             Converter="{StaticResource IsListNullOrEmptyConverter}" />
                    <Binding Path="IsBusy"
                             Converter="{StaticResource InvertedBoolConverter}" />
                </MultiBinding>
            </Label.IsVisible>
        </Label>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding GroupedEclipseList}"
                        SelectionMode="None"
                        IsGrouped="True">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="helpers:IGroupHeader">
                    <StackLayout Padding="8,0">
                        <Label Text="{Binding Key}"
                               FontAttributes="Bold"
                               FontSize="18" />
                        <BoxView Style="{StaticResource DividerStyle}" />
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ViewModels:SunEclipsesViewModel}}, Path=ToggleGroupCommand, x:DataType=ViewModels:SunEclipsesViewModel}"
                                                  CommandParameter="{Binding .}" />
                        </StackLayout.GestureRecognizers>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                                   ItemSpacing="4" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>

                <DataTemplate x:DataType="models:SolarEclipseInfo">

                    <Border>

                        <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto"
                              ColumnDefinitions="*,*"
                              ColumnSpacing="8"
                              RowSpacing="8">

                            <Label x:Name="Date"
                                   Grid.Column="0"
                                   Grid.Row="0"
                                   Style="{StaticResource CollectionViewLabel}"
                                   IsVisible="{Binding Date, Converter={StaticResource IsDateTimeSetConverter}}"
                                   Text="{Binding Date, StringFormat={localization:Localize DateLabel}}" />

                            <Label x:Name="Type"
                                   Grid.Column="1"
                                   Grid.Row="0"
                                   Style="{StaticResource CollectionViewLabel}"
                                   IsVisible="{Binding Date, Converter={StaticResource IsDateTimeSetConverter}}"
                                   Text="{Binding ., Converter={StaticResource SunEclipseTypeToNameConverter}, 
                                    StringFormat={localization:Localize TypeLabel}}" />

                            <BoxView Grid.ColumnSpan="2"
                                     Grid.Row="1"
                                     Style="{StaticResource DividerStyle}" />

                            <Label x:Name="PartialEclipseBegin"
                                   Grid.Column="0"
                                   Grid.Row="2"
                                   Style="{StaticResource CollectionViewLabel}"
                                   IsVisible="{Binding PartialEclipseBegin, Converter={StaticResource IsDateTimeSetConverter}}"
                                   Text="{Binding PartialEclipseBegin, StringFormat={localization:Localize PartialSolarEclipseBeginTimeLabel},
                                Converter={StaticResource TimeFormatConverter}}" />

                            <Label x:Name="PartialEclipseEnd"
                                   Grid.Column="1"
                                   Grid.Row="2"
                                   Style="{StaticResource CollectionViewLabel}"
                                   IsVisible="{Binding PartialEclipseEnd, Converter={StaticResource IsDateTimeSetConverter}}"
                                   Text="{Binding PartialEclipseEnd, StringFormat={localization:Localize PartialSolarEclipseEndTimeLabel},
                                Converter={StaticResource TimeFormatConverter}}" />

                            <BoxView Grid.ColumnSpan="2"
                                     Grid.Row="3"
                                     Style="{StaticResource DividerStyle}" />

                            <Label x:Name="MaximumEclipse"
                                   Grid.Column="0"
                                   Grid.Row="4"
                                   Style="{StaticResource CollectionViewLabel}"
                                   IsVisible="{Binding MaximumEclipse, Converter={StaticResource IsDateTimeSetConverter}}"
                                   Text="{Binding MaximumEclipse, StringFormat={localization:Localize MaximumSolarEclispseTimeLabel},
                                Converter={StaticResource TimeFormatConverter}}" />

                            <Label x:Name="CentralDuration"
                                   Grid.Column="1"
                                   Grid.Row="4"
                                   Style="{StaticResource CollectionViewLabel}"
                                   IsVisible="{Binding CentralDuration, Converter={StaticResource IsTimeSpanSetConverter}}"
                                   Text="{Binding CentralDuration, StringFormat={localization:Localize AorTSolarEclipseDurationLabel},
                                Converter={StaticResource TimeFormatConverter}}" />

                            <BoxView Grid.ColumnSpan="2"
                                     Grid.Row="5"
                                     Style="{StaticResource DividerStyle}" />

                            <Label x:Name="CentralEclipseBegin"
                                   Grid.Column="0"
                                   Grid.Row="6"
                                   Style="{StaticResource CollectionViewLabel}"
                                   IsVisible="{Binding CentralEclipseBegin, Converter={StaticResource IsDateTimeSetConverter}}"
                                   Text="{Binding CentralEclipseBegin, StringFormat={localization:Localize AorTEclipseBeginTimeLabel},
                                Converter={StaticResource TimeFormatConverter}}" />

                            <Label x:Name="CentralEclipseEnd"
                                   Grid.Column="1"
                                   Grid.Row="6"
                                   Style="{StaticResource CollectionViewLabel}"
                                   IsVisible="{Binding CentralEclipseEnd, Converter={StaticResource IsDateTimeSetConverter}}"
                                   Text="{Binding CentralEclipseEnd, StringFormat={localization:Localize AorTEclipseEndTimeLabel},
                                Converter={StaticResource TimeFormatConverter}}" />

                            <BoxView Grid.ColumnSpan="2"
                                     Grid.Row="7"
                                     Style="{StaticResource DividerStyle}">
                                <BoxView.IsVisible>
                                    <MultiBinding Converter="{StaticResource AnyTrueConverter}">
                                        <Binding Source="{x:Reference CentralEclipseBegin}"
                                                 Path="IsVisible"
                                                 x:DataType="Label" />
                                        <Binding Source="{x:Reference CentralEclipseEnd}"
                                                 Path="IsVisible"
                                                 x:DataType="Label" />
                                    </MultiBinding>
                                </BoxView.IsVisible>
                            </BoxView>

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- Row 1, over the list area: the century table takes a noticeable moment to
             compute, and without this the screen is simply blank while it does. -->
        <ActivityIndicator Grid.Row="1"
                           HeightRequest="50"
                           WidthRequest="50"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           IsVisible="{Binding IsBusy}"
                           IsRunning="{Binding IsBusy}" />

    </Grid>

</v1:BasePage>
