<linker>
	<!-- sqlite-net reflects over the [Table]/[PrimaryKey]-attributed row classes and the DTOs the
	     queries project into, none of which are referenced by name anywhere the linker can see.
	     The assembly is small, so preserving it wholesale is cheaper than chasing every one down. -->
	<assembly fullname="JustCompute.Persistence" preserve="all" />

	<!-- Domain entities are reached from XAML binding paths as well as from code. Compiled
	     bindings cover most of them, but not every binding in the app is compiled, and trimming a
	     property that only a binding string names fails silently at runtime rather than at build. -->
	<assembly fullname="Compute.Core" preserve="all" />

	<!-- Enum.ToString() / IFormattable paths need enum metadata that the linker would otherwise strip. -->
	<assembly fullname="System.Runtime">
		<type fullname="System.Enum" preserve="all" />
	</assembly>
</linker>
