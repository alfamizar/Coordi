                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor"
                Value="{DynamicResource ThemeOnBackground}" />
        <Setter Property="BackgroundColor"
                Value="Transparent" />
        <Setter Property="FontFamily"
                Value="OpenSansRegular" />
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeBody}" />
        <Setter Property="PlaceholderColor"
                Value="{StaticResource Gray500}" />
        <Setter Property="MinimumHeightRequest"
                Value="{StaticResource MinTouchTarget}" />
        <Setter Property="MinimumWidthRequest"
                Value="{StaticResource MinTouchTarget}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor"
                                    Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- The shared ImageButton look: filled, shrinking a little when pressed. Every ImageButton
         gets it through the implicit style after it, and the keyed button styles build on it. -->
    <Style x:Key="ImageButtonBase"
           TargetType="ImageButton">
        <Setter Property="Opacity"
                Value="1" />
        <Setter Property="BackgroundColor"
                Value="{DynamicResource ThemePrimary}" />
        <Setter Property="BorderColor"
                Value="Transparent" />
        <Setter Property="BorderWidth"
                Value="0" />
        <Setter Property="CornerRadius"
                Value="0" />
        <Setter Property="MinimumHeightRequest"
                Value="{StaticResource MinTouchTarget}" />
        <Setter Property="MinimumWidthRequest"
                Value="{StaticResource MinTouchTarget}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Scale"
                                    Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Enabled">
                        <VisualState.Setters>
                            <Setter Property="Scale"
                                    Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale"
                                    Value="0.8" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="ImageButton"
           BasedOn="{StaticResource ImageButtonBase}" />

    <!-- A glyph on no ground: a 24 icon centred in the 48 target. -->
    <Style x:Key="IconButton"
           TargetType="ImageButton"
           BasedOn="{StaticResource ImageButtonBase}">
        <Setter Property="BackgroundColor"
                Value="Transparent" />
        <Setter Property="WidthRequest"
                Value="{StaticResource MinTouchTarget}" />
        <Setter Property="HeightRequest"
                Value="{StaticResource MinTouchTarget}" />
        <Setter Property="Padding"
                Value="12" />
        <Setter Property="CornerRadius"
                Value="24" />
    </Style>

    <!-- The same 24 icon on the primary ground, filling the 48 target. -->
    <Style x:Key="FilledIconButton"
           TargetType="ImageButton"
           BasedOn="{StaticResource ImageButtonBase}">
        <Setter Property="WidthRequest"
                Value="{StaticResource MinTouchTarget}" />
        <Setter Property="HeightRequest"
                Value="{StaticResource MinTouchTarget}" />
        <Setter Property="Padding"
                Value="12" />
        <Setter Property="CornerRadius"
                Value="8" />
    </Style>

    <!-- A compact filled glyph for a dense row: 32 of ink inside an IconTarget cell that takes the
         tap, so the target still meets the 48 minimum. Inert, yet still an ImageButton: it is what
         draws these glyphs correctly on their filled ground. -->
    <Style x:Key="FilledIconChip"
           TargetType="ImageButton"
           BasedOn="{StaticResource ImageButtonBase}">
        <Setter Property="InputTransparent"
                Value="True" />
        <Setter Property="WidthRequest"
                Value="32" />
        <Setter Property="HeightRequest"
                Value="32" />
        <Setter Property="MinimumWidthRequest"
                Value="32" />
        <Setter Property="MinimumHeightRequest"
                Value="32" />
        <Setter Property="Padding"
                Value="6" />
        <Setter Property="CornerRadius"
                Value="8" />
        <Setter Property="HorizontalOptions"
                Value="Center" />
        <Setter Property="VerticalOptions"
                Value="Center" />
    </Style>

    <!-- An icon that is itself the picture, edge to edge in the 48 target: start and stop. -->
    <Style x:Key="HeroIconButton"
           TargetType="ImageButton"
           BasedOn="{StaticResource ImageButtonBase}">
        <Setter Property="BackgroundColor"
                Value="Transparent" />
        <Setter Property="WidthRequest"
                Value="{StaticResource MinTouchTarget}" />
        <Setter Property="HeightRequest"
                Value="{StaticResource MinTouchTarget}" />
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="CornerRadius"
                Value="24" />
    </Style>

    <!-- The 48 cell that takes the tap for a FilledIconChip. -->
    <Style x:Key="IconTarget"
           TargetType="Grid">
        <Setter Property="WidthRequest"
                Value="{StaticResource MinTouchTarget}" />
        <Setter Property="HeightRequest"
                Value="{StaticResource MinTouchTarget}" />
        <Setter Property="VerticalOptions"
                Value="Center" />
    </Style>

    <!-- A selectable row inside a card. Its box starts where the card's text does, so a selected
         row's outline lines up with the title above it, and its own text sits 8 inside the box.
         Cornered like a control, and drawing its own selected look - left to the platform,
         CollectionView paints a hard-edged full-bleed fill. -->
    <Style x:Key="ListRow"
           TargetType="Border">
        <Setter Property="Padding"
                Value="8" />
        <Setter Property="StrokeThickness"
                Value="1" />
        <Setter Property="Stroke"
                Value="Transparent" />
        <Setter Property="BackgroundColor"
                Value="Transparent" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="{StaticResource ControlCornerRadius}" />
            </Setter.Value>
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor"
                                    Value="Transparent" />
                            <Setter Property="Stroke"
                                    Value="Transparent" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor"
                                    Value="{DynamicResource ThemeMutedSurface}" />
                            <Setter Property="Stroke"
                                    Value="{DynamicResource ThemePrimary}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- A table of labels and their values inside a card. Every such table spaces its columns
         and rows the same, so the cards line up when read one after another. -->
    <Style x:Key="KeyValueGrid"
           TargetType="Grid">
        <Setter Property="ColumnSpacing"
                Value="{StaticResource SpacingMedium}" />
        <Setter Property="RowSpacing"
                Value="{StaticResource SpacingSmall}" />
    </Style>

