    <!-- Design System: Spacing & Dimension Scale -->
    <x:Double x:Key="SpacingMicro">4</x:Double>
    <x:Double x:Key="SpacingSmall">8</x:Double>
    <x:Double x:Key="SpacingMedium">12</x:Double>
    <x:Double x:Key="SpacingLarge">16</x:Double>
    <x:Double x:Key="SpacingXLarge">24</x:Double>

    <!-- Semantic Layout Dimensions.

         Values follow Material Design 3 for a compact window, which Apple's HIG agrees with on
         a phone: a 16 body margin, 16 of padding inside a card, 8 between cards, and a 12 corner
         on a medium surface. All sit on the 4 grid both systems are built from.

         Insets are padding only. A card carries no margin of its own: the container states the
         edge inset once, and the gap between cards is the container's Spacing. When both were in
         play the gap was 8 of Spacing plus 4 of margin at each end - 16 in total, a number written
         nowhere - and removing a card's margin silently changed the screen edge as well, because
         one property was doing two unrelated jobs. -->
    <Thickness x:Key="PageEdgeInset">16</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <x:Double x:Key="CardGap">8</x:Double>
    <x:Double x:Key="CardCornerRadius">12</x:Double>

    <!-- Material 3 puts the minimum touch target at 48; the HIG says 44. Use the larger. -->
    <x:Double x:Key="MinTouchTarget">48</x:Double>

    <!-- Design System: Typography Scale -->
    <x:Double x:Key="FontSizeDisplay">22</x:Double>
    <x:Double x:Key="FontSizeHeader">18</x:Double>
    <x:Double x:Key="FontSizeTitle">16</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeCaption">12</x:Double>

