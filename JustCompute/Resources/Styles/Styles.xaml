<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Design System: Spacing & Dimension Scale -->
    <x:Double x:Key="SpacingMicro">4</x:Double>
    <x:Double x:Key="SpacingSmall">8</x:Double>
    <x:Double x:Key="SpacingMedium">12</x:Double>
    <x:Double x:Key="SpacingLarge">16</x:Double>
    <x:Double x:Key="SpacingXLarge">24</x:Double>

    <!-- Semantic Layout Dimensions: the same roles Penombre lays its screens out with, so that
         the two apps line up with each other.

         Text starts 16 from the edge of every screen, whether it stands on the page or sits in a
         card. Cards make that work by standing 8 in from the edge and keeping their content 8 in
         from their own sides: the two add up to the same line. Material 3's compact layout puts
         both at 16, which lands card text at 32 - more margin than an app of tables can spare on
         a phone, and text that jumps sideways between a page of cards and a page without.

         Insets are padding only. A card carries no margin of its own: the page states the edge
         inset once, and the gap between cards is the page's Spacing. -->
    <!-- A page of cards: the cards 8 from every edge. -->
    <Thickness x:Key="CardPageInset">8</Thickness>
    <!-- A page without cards: its text and controls straight on the 16 line. -->
    <Thickness x:Key="TextPageInset">16</Thickness>
    <!-- Text standing among cards rather than in one, such as a section heading or a filter row:
         8 in from the cards' edge, which puts it on the same 16 line as their text. -->
    <Thickness x:Key="TextBesideCardsInset">8,0</Thickness>
    <!-- Inside a card: 8 at the sides, which lands its text on the 16 line, and 12 above and below. -->
    <Thickness x:Key="CardPadding">8,12</Thickness>
    <!-- Between one card and the next. -->
    <x:Double x:Key="CardGap">12</x:Double>
    <!-- Between the rows of a card. -->
    <x:Double x:Key="RowGap">8</x:Double>
    <x:Double x:Key="CardCornerRadius">12</x:Double>
    <!-- A dialog floats free of the screen's edges, so the 16 line means nothing to it: it keeps
         the roomier inset all round. -->
    <Thickness x:Key="DialogPadding">16</Thickness>

    <!-- Controls and rows that sit inside a card: a step tighter than the card's 12, so a corner
         inside a corner reads as nested. Buttons, whose CornerRadius is a whole number, state the
         same 8 in their styles below. -->
    <x:Double x:Key="ControlCornerRadius">8</x:Double>

    <!-- Material 3 puts the minimum touch target at 48; the HIG says 44. Use the larger. -->
    <x:Double x:Key="MinTouchTarget">48</x:Double>

    <!-- Design System: Typography Scale -->
    <!-- Live readouts meant to be read at arm's length: a speed, a running time. -->
    <x:Double x:Key="FontSizeHero">28</x:Double>
    <x:Double x:Key="FontSizeDisplay">22</x:Double>
    <x:Double x:Key="FontSizeHeader">18</x:Double>
    <x:Double x:Key="FontSizeTitle">16</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeCaption">12</x:Double>
    <!-- Only for the seven days of the weather strip, a seventh of a phone's card each. Below
         Material's smallest (11) on purpose: at 11, with the phone's text scaled up a step, a
         date like "10 Oct" runs into the column dividers. -->
    <x:Double x:Key="FontSizeMicro">10</x:Double>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color"
                Value="{DynamicResource ThemePrimary}" />
        <!-- One size everywhere; the screens used to state 50 each. -->
        <Setter Property="HeightRequest"
                Value="{StaticResource MinTouchTarget}" />
        <Setter Property="WidthRequest"
                Value="{StaticResource MinTouchTarget}" />
    </Style>

    <Style TargetType="IndicatorView">
        <Setter Property="IndicatorColor"
                Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}" />
        <Setter Property="SelectedIndicatorColor"
                Value="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray100}}" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke"
                Value="Transparent" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="{StaticResource CardCornerRadius}" />
            </Setter.Value>
        </Setter>
        <Setter Property="StrokeThickness"
                Value="0" />
        <Setter Property="Background"
                Value="{DynamicResource ThemeSurface}" />
        <Setter Property="Padding"
                Value="{StaticResource CardPadding}" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="Color"
                Value="{DynamicResource ThemeOnBackground}" />
    </Style>

    <Style TargetType="BoxView"
           x:Key="DividerStyle">
        <Setter Property="HeightRequest"
                Value="1" />
        <Setter Property="Color"
                Value="{DynamicResource ThemeOutline}" />
    </Style>

    <!-- Inside the dialog's Border, which gives it the card's surface, corner and padding. -->
    <Style TargetType="Grid"
           x:Key="GridDialogContent">
        <Setter Property="RowSpacing"
                Value="{StaticResource SpacingSmall}" />
        <Setter Property="ColumnSpacing"
                Value="{StaticResource SpacingSmall}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="TextColor"
                Value="{DynamicResource ThemeOnPrimary}" />
        <Setter Property="BackgroundColor"
                Value="{DynamicResource ThemePrimary}" />
        <Setter Property="FontFamily"
                Value="OpenSansRegular" />
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeBody}" />
        <Setter Property="CornerRadius"
                Value="8" />
        <!-- The 48 minimum sets the height, so the padding is for the label's sake: 12 at the
             sides, not Material's 24, leaves the most room where two buttons share a row. -->
        <Setter Property="Padding"
                Value="12,8" />
        <Setter Property="MinimumHeightRequest"
                Value="{StaticResource MinTouchTarget}" />
        <Setter Property="MinimumWidthRequest"
                Value="{StaticResource MinTouchTarget}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor"
                                    Value="{StaticResource Gray500}" />
                            <Setter Property="BackgroundColor"
                                    Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}" />
                            <Setter Property="Opacity"
                                    Value="0.6" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- The second strength of button. The plain filled Button is for the one action a card or a
         dialog is there for; everything beside it - cancel, undo, a step back - is outlined, so
         the eye goes to the right one first. Label and outline are the accent colour, which every
         palette keeps readable on a card. -->
    <Style TargetType="Button"
           x:Key="OutlinedButton">
        <Setter Property="BackgroundColor"
                Value="Transparent" />
        <Setter Property="TextColor"
                Value="{DynamicResource ThemeAccentStrong}" />
        <Setter Property="BorderColor"
                Value="{DynamicResource ThemeAccentStrong}" />
        <Setter Property="BorderWidth"
                Value="1" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor"
                                    Value="{StaticResource Gray500}" />
                            <Setter Property="BorderColor"
                                    Value="{StaticResource Gray500}" />
                            <Setter Property="Opacity"
                                    Value="0.6" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color"
                Value="{DynamicResource ThemePrimary}" />
        <Setter Property="MinimumHeightRequest"
                Value="{StaticResource MinTouchTarget}" />
        <Setter Property="MinimumWidthRequest"
