    <Style TargetType="Switch">
        <Setter Property="OnColor"
                Value="{DynamicResource ThemePrimary}" />
        <Setter Property="ThumbColor"
                Value="{StaticResource White}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="OnColor"
                                    Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                            <Setter Property="ThumbColor"
                                    Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="On">
                        <VisualState.Setters>
                            <Setter Property="OnColor"
                                    Value="{DynamicResource ThemeSecondary}" />
                            <Setter Property="ThumbColor"
                                    Value="{DynamicResource ThemePrimary}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Off">
                        <VisualState.Setters>
                            <Setter Property="ThumbColor"
                                    Value="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="TextColor"
                Value="{DynamicResource ThemeOnBackground}" />
        <Setter Property="BackgroundColor"
                Value="Transparent" />
        <Setter Property="FontFamily"
                Value="OpenSansRegular" />
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeBody}" />
        <Setter Property="MinimumHeightRequest"
                Value="{StaticResource MinTouchTarget}" />
        <Setter Property="MinimumWidthRequest"
                Value="{StaticResource MinTouchTarget}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor"
                                    Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Page"
           ApplyToDerivedTypes="True">
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="BackgroundColor"
                Value="{DynamicResource ThemeBackground}" />
    </Style>

    <Style TargetType="Shell"
           ApplyToDerivedTypes="True">
        <Setter Property="Shell.FlyoutBackground"
                Value="{DynamicResource ThemeHeaderBackground}" />
        <Setter Property="Shell.BackgroundColor"
                Value="{DynamicResource ThemeHeaderBackground}" />
        <Setter Property="Shell.ForegroundColor"
                Value="{StaticResource White}" />
        <Setter Property="Shell.TitleColor"
                Value="{StaticResource White}" />
        <Setter Property="Shell.DisabledColor"
                Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray950}}" />
        <Setter Property="Shell.UnselectedColor"
                Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray200}}" />
        <Setter Property="Shell.NavBarHasShadow"
                Value="True" />
        <Setter Property="Shell.TabBarBackgroundColor"
                Value="{DynamicResource ThemeHeaderBackground}" />
        <Setter Property="Shell.TabBarForegroundColor"
                Value="{StaticResource White}" />
        <Setter Property="Shell.TabBarTitleColor"
                Value="{StaticResource White}" />
        <!-- An unselected tab reads at 4.5:1 too: white on the light palettes' saturated headers,
             where any dimmer tint fell under it, and Gray300 on the dark ones. With both states
             that bright, the selected tab is told apart by the chip IndicatedTabsShellRenderer
             draws behind it on Android, not by a shade; iOS's glass bar has a platter of its own. -->
        <Setter Property="Shell.TabBarUnselectedColor"
                Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray300}}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor"
                Value="{DynamicResource ThemeHeaderBackground}" />
        <Setter Property="BarTextColor"
                Value="{StaticResource White}" />
        <Setter Property="IconColor"
                Value="{StaticResource White}" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor"
                Value="{DynamicResource ThemeHeaderBackground}" />
        <Setter Property="BarTextColor"
                Value="{StaticResource White}" />
        <Setter Property="UnselectedTabColor"
                Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray950}}" />
        <Setter Property="SelectedTabColor"
                Value="{StaticResource White}" />
    </Style>

    <Style TargetType="Label"
           x:Key="TitleLabel">
        <Setter Property="VerticalOptions"
                Value="Start" />
        <Setter Property="VerticalTextAlignment"
                Value="Center" />
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontAttributes"
                Value="Bold" />
        <Setter Property="TextColor"
                Value="{DynamicResource ThemeOnBackground}" />
    </Style>

    <Style TargetType="Label"
           x:Key="SectionHeaderLabel">
        <Setter Property="VerticalOptions"
                Value="Center" />
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeHeader}" />
        <Setter Property="FontAttributes"
                Value="Bold" />
        <Setter Property="TextColor"
                Value="{DynamicResource ThemeOnBackground}" />
    </Style>

    <Style TargetType="Label"
           x:Key="CollectionViewLabel">
        <Setter Property="VerticalOptions"
                Value="Center" />
        <Setter Property="VerticalTextAlignment"
                Value="Center" />
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeBody}" />
        <Setter Property="TextColor"
                Value="{DynamicResource ThemeOnBackground}" />
    </Style>

    <Style TargetType="Label"
           x:Key="CaptionLabel">
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeCaption}" />
        <Setter Property="TextColor"
                Value="{DynamicResource ThemeOnBackground}" />
        <Setter Property="Opacity"
                Value="0.8" />
    </Style>

    <!-- What a screen says when it has nothing to show yet, or found nothing: centred, its lines
         kept within the 16 text line at the sides, and the same distance from what is above and
         below it on every screen. -->
    <Style TargetType="Label"
           x:Key="HintLabel">
        <Setter Property="HorizontalTextAlignment"
                Value="Center" />
        <Setter Property="Padding"
                Value="8,16" />
    </Style>

    <Style TargetType="Label"
           x:Key="ErrorLabel">
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeCaption}" />
        <Setter Property="TextColor"
                Value="{DynamicResource ThemeError}" />
    </Style>

    <!-- A dialog reads title first: the question in the header size, the explanation under it in
         body text. It was the other way round, a small uppercase title over an 18-point message. -->
    <Style TargetType="Label"
           x:Key="DialogTitle">
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeHeader}" />
        <Setter Property="FontAttributes"
                Value="Bold" />
    </Style>

    <Style TargetType="Label"
           x:Key="DialogMessage">
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeBody}" />
        <Setter Property="LineBreakMode"
                Value="WordWrap" />
    </Style>

    <Style Class="FlyoutItemLayoutStyle"
           TargetType="Layout"
           ApplyToDerivedTypes="True">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor"
                                    Value="{DynamicResource ThemeHeaderBackground}" />
                            <Setter TargetName="FlyoutItemLabel"
                                    Property="Label.TextColor"
                                    Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray200}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor"
                                    Value="{DynamicResource ThemePrimaryVariant}" />
                            <Setter TargetName="FlyoutItemLabel"
                                    Property="Label.TextColor"
                                    Value="{StaticResource White}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style Class="FlyoutItemLabelStyle"
           TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray200}}" />
        <Setter Property="HorizontalTextAlignment"
                Value="Start" />
        <Setter Property="VerticalTextAlignment"
                Value="Center" />
        <Setter Property="FontFamily"
                Value="OpenSansRegular" />
        <Setter Property="FontSize"
                Value="{StaticResource FontSizeBody}" />
        <Setter Property="HeightRequest"
                Value="{StaticResource MinTouchTarget}" />
    </Style>

</ResourceDictionary>
