<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <Color x:Key="Yellow100Accent">#F7B548</Color>
    <Color x:Key="Yellow200Accent">#FFD590</Color>
    <Color x:Key="Yellow300Accent">#FFE5B9</Color>
    <Color x:Key="Cyan100Accent">#28C2D1</Color>
    <Color x:Key="Cyan200Accent">#7BDDEF</Color>
    <Color x:Key="Cyan300Accent">#C3F2F4</Color>
    <Color x:Key="Blue100Accent">#3E8EED</Color>
    <Color x:Key="Blue200Accent">#72ACF1</Color>
    <Color x:Key="Blue300Accent">#A7CBF6</Color>

    <!--
        Light theme: rose pink chrome over mint-green surfaces.

        The primary is deliberately deeper than it looks like it needs to be. Buttons and the
        app bar put white text on it at 14pt, so it has to clear 4.5:1 to be readable — the
        previous #00A9FF managed only 2.59:1 and failed even the large-text threshold. #DB2777
        gives 4.60:1 while still reading as pink rather than maroon.
    -->
    <Color x:Key="LightPrimary">#DB2777</Color>
    <Color x:Key="LightOnPrimary">#FFFFFF</Color>
    <Color x:Key="LightPrimaryVariant">#A81B5C</Color>
    <Color x:Key="LightSecondary">#A5D6A7</Color>
    <Color x:Key="LightOnSecondary">#14321A</Color>
    <Color x:Key="LightBackground">#FFF7FB</Color>
    <Color x:Key="LightOnBackground">#212121</Color>
    <Color x:Key="LightSurface">#E4F7E2</Color>
    <Color x:Key="LightOnSurface">#212121</Color>
    <Color x:Key="LightOutline">#8FCB92</Color>
    <Color x:Key="LightError">#B00020</Color>
    <Color x:Key="LightOnError">#FFFFFF</Color>

    <Color x:Key="DarkPrimary">#FF1E56</Color>
    <Color x:Key="DarkOnPrimary">#FFFFFF</Color>
    <Color x:Key="DarkPrimaryVariant">#CC1845</Color>
    <Color x:Key="DarkSecondary">#FFAC41</Color>
    <Color x:Key="DarkOnSecondary">#000000</Color>
    <Color x:Key="DarkBackground">#000000</Color>
    <Color x:Key="DarkOnBackground">#FFFFFF</Color>
    <Color x:Key="DarkSurface">#323232</Color>
    <Color x:Key="DarkOnSurface">#FFFFFF</Color>
    <Color x:Key="DarkOutline">#4A4A4A</Color>
    <Color x:Key="DarkError">#CF6679</Color>
    <Color x:Key="DarkOnError">#000000</Color>

    <!--
        Semantic theme slots. These are what the XAML actually binds to, through DynamicResource,
        and ThemeHandler rewrites them whenever the chosen theme changes — which is what lets the
        theme switch take effect without rebuilding the pages.

        The values here are only the parse-time defaults (the Ocean palette); the real ones are
        applied at startup. The Light*/Dark* entries above remain as the palettes' source of
        record and for anything still keyed to the device's own light/dark setting.
    -->
    <Color x:Key="ThemePrimary">#00A9FF</Color>
    <Color x:Key="ThemeOnPrimary">#FFFFFF</Color>
    <Color x:Key="ThemePrimaryVariant">#0086CC</Color>
    <Color x:Key="ThemeSecondary">#89CFF3</Color>
    <Color x:Key="ThemeOnSecondary">#000000</Color>
    <Color x:Key="ThemeBackground">#FFFFFF</Color>
    <Color x:Key="ThemeOnBackground">#212121</Color>
    <Color x:Key="ThemeSurface">#CDF5FD</Color>
    <Color x:Key="ThemeOnSurface">#212121</Color>
    <Color x:Key="ThemeOutline">#89CFF3</Color>
    <Color x:Key="ThemeError">#B00020</Color>
    <Color x:Key="ThemeOnError">#FFFFFF</Color>
    <Color x:Key="ThemeHeaderBackground">#00A9FF</Color>
    <Color x:Key="ThemeMutedSurface">#89CFF3</Color>
    <Color x:Key="ThemeAccentStrong">#0086CC</Color>

    <Color x:Key="LightStatusBarColor">#DB2777</Color>
    <Color x:Key="DarkStatusBarColor">#323232</Color>
    <Color x:Key="LightNavigationBarColor">#DB2777</Color>
    <Color x:Key="DarkNavigationBarColor">#323232</Color>

</ResourceDictionary>
